# Copie para api/.env e preencha. Gere chaves com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_CHAVE_DISPOSITIVO=
API_CHAVE_EQUIPE=
# Banco SQLite (relativo à raiz do repositório)
BANCO_SQLITE=api/dados/cardioia.db
# Servidor SMTP de teste (Mailpit em Docker); nada sai para a internet
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_DE=monitor@cardioia.local
EMAIL_PARA=equipe@cardioia.local
# Segundos sem leitura até avisar a equipe
SILENCIO_S=60
