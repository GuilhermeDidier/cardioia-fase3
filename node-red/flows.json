    {
        "id": "fn_normaliza",
        "type": "function",
        "z": "tab_cardioia",
        "name": "normaliza (horário + série)",
        "func": "// O ESP32 não tem relógio: cada leitura traz há quanto tempo foi feita\n// (idade_ms). Reconstruímos o horário real para que as leituras que\n// ficaram no buffer durante a queda apareçam no lugar certo do gráfico.\nconst p = msg.payload;\nif (!p || typeof p !== 'object' || typeof p.seq !== 'number' || typeof p.bpm !== 'number') {\n    node.warn('payload ignorado: ' + JSON.stringify(p));\n    return null;\n}\nif (!Number.isFinite(p.idade_ms) || p.idade_ms < 0) {\n    node.warn(`idade_ms inválida na seq ${p.seq}: ${p.idade_ms}`);\n    return null;\n}\nconst agora = Date.now();\nconst ts = agora - p.idade_ms;\n\n// Série de BPM ordenada por horário da leitura (janela de 15 min).\n// O gráfico recebe a série inteira (modo \"replace\"), então leituras\n// sincronizadas fora de ordem não viram zigue-zague.\nconst JANELA_MS = 15 * 60 * 1000;\nconst LACUNA_MS = 6000;   // 3 leituras perdidas: o gráfico mostra um buraco em vez de ligar os pontos\nlet serie = flow.get('serieBpm') || [];\nserie.push({ x: ts, y: p.bpm });\nserie = serie.filter(pt => pt.x >= agora - JANELA_MS).sort((a, b) => a.x - b.x);\nflow.set('serieBpm', serie);\nconst grafico = [];\nserie.forEach((pt, i) => {\n    if (i > 0 && pt.x - serie[i - 1].x > LACUNA_MS) grafico.push({ x: pt.x - 1, y: null });\n    grafico.push(pt);\n});\n\n// Gauges e painel mostram só a leitura mais recente, não a que chega atrasada do buffer\nconst maisRecente = ts >= (flow.get('ultimoTs') || 0);\nif (maisRecente) flow.set('ultimoTs', ts);\n\n// Sem leitura do DHT22, o gauge avisa no título em vez de mostrar o último valor como atual.\n// O título só é reenviado quando muda (com leitura <-> sem leitura).\nconst gauge = (valor, titulo, chave) => {\n    const semLeitura = valor == null;\n    const msgGauge = semLeitura ? {} : { payload: valor };\n    if (flow.get(chave) !== semLeitura) {\n        flow.set(chave, semLeitura);\n        msgGauge.ui_update = { title: semLeitura ? titulo + ' — sem leitura' : titulo };\n    }\n    return 'payload' in msgGauge || msgGauge.ui_update ? msgGauge : null;\n};\n\nreturn [\n    { topic: 'Frequência cardíaca', payload: grafico },\n    maisRecente ? gauge(p.temp, 'Temperatura corporal', 'tempSemLeitura') : null,\n    maisRecente ? gauge(p.umid, 'Umidade (sem alerta)', 'umidSemLeitura') : null,\n    { payload: { ...p, ts }, maisRecente }\n];",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 140,
        "wires": [
