    {
        "id": "tpl_estado",
        "type": "ui-template",
        "z": "tab_cardioia",
        "group": "grp_estado",
        "page": "",
        "ui": "",
        "name": "Estado do paciente",
        "order": 1,
        "width": "0",
        "height": "0",
        "head": "",
        "format": "<template>\n  <div v-if=\"msg && msg.payload\" :class=\"['estado', msg.payload.alerta ? 'alerta' : 'normal']\">\n    <div class=\"titulo\">{{ msg.payload.alerta ? 'ALERTA — ' + msg.payload.motivo : 'Sinais vitais normais' }}</div>\n    <div class=\"valores\">{{ msg.payload.bpm }} bpm · {{ msg.payload.temp ?? '—' }} °C · {{ msg.payload.umid ?? '—' }}% umidade</div>\n    <div class=\"meta\">\n      Leitura #{{ msg.payload.seq }} às {{ new Date(msg.payload.ts).toLocaleTimeString('pt-BR', { timeZone: 'America/Sao_Paulo' }) }}\n      · {{ msg.payload.origem === 'buffer' ? 'veio do buffer offline' : 'tempo real' }}\n    </div>\n  </div>\n  <div v-else class=\"estado vazio\">Aguardando a primeira leitura do ESP32…</div>\n</template>\n\n<style scoped>\n.estado { border-radius: 8px; padding: 16px 20px; color: #fff; }\n.estado.normal { background: #1e7a46; }\n.estado.alerta { background: #c62828; }\n.estado.vazio { background: #eceff1; color: #455a64; }\n.titulo { font-size: 1.5rem; font-weight: 700; text-transform: uppercase; letter-spacing: .02em; }\n.valores { font-size: 1.15rem; margin-top: 6px; }\n.meta { font-size: .85rem; opacity: .85; margin-top: 6px; }\n</style>",
        "storeOutMessages": true,
        "passthru": false,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 880,
        "y": 260,
        "wires": [
            []
        ]
    },
    {
        "id": "fn_notifica",
        "type": "function",
        "z": "tab_cardioia",
        "name": "quando notificar",
        "func": "// Decide quando avisar a equipe, sem notificar a cada 2 segundos:\n// - tempo real: só quando o estado muda (entrou em alerta / normalizou);\n// - buffer: junta os alertas que vieram do buffer e avisa uma vez, no\n//   último registro da sincronização (buffer_pendente = 0).\nconst p = msg.payload;\nconst hora = (ts) => new Date(ts).toLocaleTimeString('pt-BR', { timeZone: 'America/Sao_Paulo' });\n\n// \"taquicardia ×3, febre ×1 (primeiro às 17:44:10)\"\nfunction resumo(lista) {\n    const contagem = {};\n    lista.forEach(a => a.motivo.split('+').forEach(m => { contagem[m] = (contagem[m] || 0) + 1; }));\n    const tipos = Object.entries(contagem).map(([m, n]) => `${m} ×${n}`).join(', ');\n    return `${lista.length} leitura(s) em alerta vieram do buffer offline: ${tipos} (primeira às ${hora(lista[0].ts)})`;\n}\n\nif (p.origem === 'buffer') {\n    const offline = flow.get('alertasOffline') || [];\n    if (p.alerta) offline.push({ ts: p.ts, motivo: p.motivo });\n    flow.set('alertasOffline', offline);\n    if (p.buffer_pendente !== 0) return null;\n    // Fim da sincronização: o estado de referência passa a ser o da última leitura,\n    // para a próxima leitura em tempo real não anunciar uma mudança que já aconteceu offline\n    flow.set('motivoAnterior', p.motivo);\n    flow.set('alertasOffline', []);\n    if (!offline.length) return null;\n    return { payload: 'Sincronização: ' + resumo(offline), ui_update: { color: 'orange', displayTime: 15 } };\n}\n\n// Se a sincronização foi interrompida antes do último registro, os alertas\n// acumulados saem junto com a primeira leitura em tempo real.\nconst pendentes = flow.get('alertasOffline') || [];\nif (pendentes.length) {\n    flow.set('alertasOffline', []);\n    node.send({ payload: 'Sincronização incompleta: ' + resumo(pendentes), ui_update: { color: 'orange', displayTime: 15 } });\n}\n\nconst anterior = flow.get('motivoAnterior') ?? '';\nif (p.motivo === anterior) return null;\nflow.set('motivoAnterior', p.motivo);\nif (p.alerta) {\n    return {\n        payload: `ALERTA — ${p.motivo} (${p.bpm} bpm, ${p.temp ?? '—'} °C) às ${hora(p.ts)}`,\n        ui_update: { color: 'red', displayTime: 15 }\n    };\n}\nreturn { payload: `Paciente voltou à faixa normal às ${hora(p.ts)}`, ui_update: { color: 'green', displayTime: 6 } };",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 320,
        "wires": [
