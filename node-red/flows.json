    {
        "id": "fn_disp",
        "type": "function",
        "z": "tab_cardioia",
        "name": "status do dispositivo",
        "func": "// Status do ESP32 (retained + Last Will): online, ocupação do buffer,\n// descartes e leituras sincronizadas, todos contados pelo próprio dispositivo.\nconst s = msg.payload;\nif (!s || typeof s !== 'object') return null;\n\n// O Last Will só diz \"offline\": mantém os últimos números conhecidos em vez de inventar zeros\nconst ultimo = flow.get('ultimoStatus') || {};\nconst status = s.motivo === 'lwt' ? { ...ultimo, online: false, motivo: 'lwt' } : s;\nflow.set('ultimoStatus', status);\nconst painel = { payload: { ...status, recebido: Date.now() } };\n\nconst estavaOnline = flow.get('dispositivoOnline');\nflow.set('dispositivoOnline', s.online);\nlet aviso = null;\nif (estavaOnline !== undefined && estavaOnline !== s.online) {\n    aviso = s.online\n        ? { payload: `ESP32 de volta online (${s.buffer} leitura(s) no buffer para sincronizar)`, ui_update: { color: 'blue', displayTime: 6 } }\n        : { payload: 'ESP32 offline — as leituras ficam no buffer local até a conexão voltar', ui_update: { color: 'orange', displayTime: 10 } };\n}\nreturn [painel, aviso];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 520,
        "wires": [
            [
                "tpl_disp"
