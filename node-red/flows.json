    {
        "id": "fn_avalia",
        "type": "function",
        "z": "tab_cardioia",
        "name": "avalia alerta (limiares)",
        "func": "// Limiares de alerta — os mesmos do firmware (defesa em profundidade:\n// o ESP32 classifica para decidir o que preservar no buffer, e o\n// Node-RED reavalia para não depender de um único ponto).\nconst LIMIARES = {\n    BPM_TAQUICARDIA: 120,   // > 120 bpm\n    BPM_BRADICARDIA: 50,    // < 50 bpm\n    TEMP_FEBRE: 38.0,       // > 38,0 °C\n    TEMP_HIPOTERMIA: 35.0   // < 35,0 °C\n};\nconst p = msg.payload;\nconst motivos = [];\nif (p.bpm > LIMIARES.BPM_TAQUICARDIA) motivos.push('taquicardia');\nif (p.bpm < LIMIARES.BPM_BRADICARDIA) motivos.push('bradicardia');\nif (p.temp != null && p.temp > LIMIARES.TEMP_FEBRE) motivos.push('febre');\nif (p.temp != null && p.temp < LIMIARES.TEMP_HIPOTERMIA) motivos.push('hipotermia');\n\nconst alerta = motivos.length > 0;\nif (alerta !== p.alerta) {\n    node.warn(`Divergência ESP32 x Node-RED na seq ${p.seq}: esp32=${p.alerta} node-red=${alerta}`);\n}\nmsg.payload = { ...p, alerta, motivo: motivos.join('+') };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 260,
        "wires": [
